 "sources": [
  {
   "claim": "Ideal-X, 26 April 1956, 58 containers, Newark to Houston; loading cost 15.8 cents/ton vs $5.83/ton break-bulk; freight 10-30% of import cost",
   "url": "https://worksthatwork.com/2/intermodal-container",
   "note": "Essay by Marc Levinson (author of 'The Box', Princeton UP): McLean's accountants pegged Ideal-X loading at 15.8 cents per ton vs US$5.83 for average break-bulk."
  },
  {
   "claim": "Ideal-X route/date; McLean allowed Sea-Land patents to be used royalty-free for standard corner fittings",
   "url": "https://www.smithsonianmag.com/innovation/shipping-container-idea-before-time-180963730/",
   "note": "Levinson in Smithsonian Magazine: 'He agreed to allow the industry to use Sea-Land's patents royalty-free so that every container in every country could use the same corner fittings.'"
  },
  {
   "claim": "The value was in the system, not the box; earlier containers existed",
   "url": "https://www.library.hbs.edu/working-knowledge/the-truck-driver-who-reinvented-shipping",
   "note": "HBS Working Knowledge: no business before McLean was dedicated to a systematic process of hauling boxed cargo."
  },
  {
   "claim": "Containerization raised trade more than FTAs/GATT among industrialized countries (1962-1990)",
   "url": "https://cris.brighton.ac.uk/ws/portalfiles/portal/376845/JIE%20accepted%20manuscript%20online%20version%20(1).pdf",
   "note": "Bernhofen, El-Sahli & Kneller 2016, J. International Economics 98:36-50. Cumulative effect for North-North trade described as much larger than FTAs or GATT."
  }
 ],
 "caveats": "The 15.8 cents vs $5.83 figures are McLean's company estimate as reported by Levinson, not an independent audit; narration attributes them to 'McLean's own figures'. Line 6 is one econometric study and applies to industrialized (North-North) trade 1962-1990; wording limited to 'rich countries'. Round 3 shows the cost drop as a large '$5.83' coin and a small '16¢' coin; coin sizes are illustrative, not to scale (the real ratio is 15.8/583, ~2.7%). 'Trucking boss' = McLean owned a large trucking company. Round-4 edit: the cost drop is now shown as two bars drawn to scale (by box = 2.7% of by hand); the 'containers vs trade deals' bars are illustrative of 'more than', not the paper's coefficients.",
