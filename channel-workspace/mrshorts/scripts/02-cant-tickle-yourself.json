 "sources": [
  {
   "claim": "Self-produced touch feels less ticklish; cerebellum activity linked to predicting and cancelling it",
   "url": "https://www.semanticscholar.org/paper/Central-cancellation-of-self-produced-tickle-Blakemore-Wolpert/a17227b5876b83a822308b4fe265c908ddc59f19",
   "note": "Blakemore, Wolpert & Frith 1998, Nature Neuroscience 1(7):635-640. fMRI: less somatosensory activity for self-produced touch; cerebellum implicated in predicting sensory consequences of movement."
  },
  {
   "claim": "Robot setup; tickle ratings rose as the delay grew from 0 to 200 ms",
   "url": "https://wolpertlab.neuroscience.columbia.edu/sites/wolpertlab.neuroscience.columbia.edu/files/content/papers/BlaFriWol99.pdf",
   "note": "Blakemore, Frith & Wolpert 1999, J Cogn Neurosci 11(5):551-559 (verified against full text). 'There was a significant increase in Tickly rating as the delay ... increased from 0 to 200 msec. There was no significant difference between ratings at 200- and 300-msec delay and in the externally produced tactile stimuli condition.' 16 subjects."
  },
  {
   "claim": "Patients with auditory hallucinations/passivity experiences show no self vs. external tickle difference",
   "url": "https://www.cambridge.org/core/journals/psychological-medicine/article/abs/perception-of-selfproduced-sensory-stimuli-in-patients-with-auditory-hallucinations-and-passivity-experiences-evidence-for-a-breakdown-in-selfmonitoring/8EB94550E108943088B294EAA4891F74",
   "note": "Blakemore et al. 2000, Psychological Medicine 30:1131-1139. Controls and patients without these symptoms rated self-touch less tickly; patients with hallucinations/passivity did not."
  }
 ],
 "caveats": "Line 3 says 'point to' and 'part of' deliberately: the cerebellum is implicated, not proven to be the sole mechanism. Line 6 is one smallish 2000 study of psychiatric patients (with auditory hallucinations and/or passivity experiences); don't generalise it to 'all people with schizophrenia'. The '1998' visual refers to the Nature Neuroscience fMRI paper. Round-2 edit: line 4 now says 'much more ticklish, almost like someone else's touch' rather than 'as ticklish as': the paper reports ratings rising with delay and no significant difference from external touch at 200 ms, which is not the same as proven equivalence (small sample, rank ratings).",
