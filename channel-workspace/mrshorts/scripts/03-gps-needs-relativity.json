 "sources": [
  {
   "claim": "Altitude ~20,000 km, speed ~14,000 km/h; -7 μs/day (special), +45 μs/day (general), net +38 μs/day; ~10 km/day error",
   "url": "https://www.astronomy.ohio-state.edu/pogge.1/Ast162/Unit5/gps.html",
   "note": "Richard Pogge, Ohio State University astronomy course page 'Real-World Relativity: The GPS Navigation System'."
  },
  {
   "claim": "Satellite clocks pre-set to 10.22999999543 MHz instead of 10.23 MHz",
   "url": "https://link.springer.com/article/10.12942/lrr-2003-1",
   "note": "Neil Ashby 2003, 'Relativity in the Global Positioning System', Living Reviews in Relativity 6:1 (net gain ~38.6 μs/day; fractional frequency offset applied before launch)."
  },
  {
   "claim": "NIST on GPS and relativity",
   "url": "https://www.nist.gov/atomic-clocks/a-powerful-tool-for-science/putting-einstein-test",
   "note": "Background/pointer from NIST."
  }
 ],
 "caveats": "The '10 km per day' figure is the standard popular estimate (Pogge); physicists note the real failure mode is more complex, since receivers also solve for their own clock offset. Narration says 'roughly' and 'position errors would grow', which is defensible. Satellite altitude is 20,200 km above the surface; rounded to 20,000.",
