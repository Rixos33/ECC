 "sources": [
  {
   "claim": "Seizure-over-intercom study: 85% (alone) vs 31% (four other bystanders) reported the emergency before the victim's fit ended",
   "url": "https://psycnet.apa.org/doi/10.1037/h0025589",
   "note": "Darley & Latané 1968, 'Bystander intervention in emergencies: Diffusion of responsibility', JPSP 8:377-383. Figures also given in many textbook summaries (e.g., simplypsychology.org/bystander-effect.html)."
  },
  {
   "claim": "219 CCTV-captured public conflicts in Amsterdam, Lancaster, Cape Town; intervention in ~91%; more bystanders linked to greater likelihood someone helps",
   "url": "https://research.lancaster-university.uk/en/publications/would-i-be-helped-cross-national-cctv-footage-shows-that-interven/",
   "note": "Philpot, Liebst, Levine, Bernasco & Lindegaard, American Psychologist 75(1):66-75 (online 2019, print 2020). See also ScienceDaily summary: https://www.sciencedaily.com/releases/2019/06/190626125049.htm"
  },
  {
   "claim": "Bystander effect is weaker in dangerous emergencies",
   "url": "https://www.semanticscholar.org/paper/The-bystander-effect:-a-meta-analytic-review-on-in-Fischer-Krueger/43e957f87e561c4d2d65715e6fe94e872b34299e",
   "note": "Fischer et al. 2011 meta-analysis, Psychological Bulletin 137(4):517-537 (overall effect g = -0.35, attenuated in dangerous situations)."
  }
 ],
 "caveats": "Both findings can be true: the lab effect is about each individual's likelihood of acting, while the CCTV study measures whether anyone in the group acts. The CCTV data cover public conflicts (arguments, fights), not every kind of emergency (e.g., medical collapse). The paper was published online in 2019, print issue dated 2020. Darley & Latané's '85% vs 31%' is 'before the end of the fit'; by the end of the session most participants in all conditions eventually responded (62% in six-person groups).",
